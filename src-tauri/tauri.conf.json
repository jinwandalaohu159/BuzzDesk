{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BuzzDesk",
  "version": "0.1.2",
  "identifier": "local.buzzdesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BuzzDesk",
        "width": 1280,
        "height": 720,
        "decorations": false,
        "maximized": true,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
