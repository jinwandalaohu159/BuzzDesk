{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Layer",
  "version": "0.1.0",
  "identifier": "local.desktop.layer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Desktop Layer",
        "width": 1280,
        "height": 720,
        "decorations": false,
        "maximized": true,
        "transparent": true,
        "resizable": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
